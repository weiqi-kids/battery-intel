{"id": "nio-2026-10-11-014", "date": "2026-10-11", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 41, "weekday": "Sun"}, "entities": {"companies": ["nio"], "customers": [], "suppliers": []}, "topics": ["industry_general"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Nio reaches 500 swap stations in Guangdong, with over 17 million swaps completed", "content": "<p><img src=\"https://cnevpost.com/wp-content/uploads/2026/10/2026101108191736.jpg\" alt=\"\" style=\"max-width: 100%; height: auto;\" /></p><p>Guangdong accounts for about 13% of Nio's cumulative battery swaps in China.</p>\n<p>For details, please visit <a href=\"https://cnevpost.com\">CnEVPost</a> (cnev.co).</p>\n", "sources": [{"name": "cnevpost", "url": "https://cnevpost.com/2026/10/11/nio-500-swap-stations-guangdong/", "type": "rss"}]}
{"id": "catl-2026-10-11-015", "date": "2026-10-11", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 41, "weekday": "Sun"}, "entities": {"companies": ["catl"], "customers": [], "suppliers": []}, "topics": ["industry_general"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["expand"]}, "importance": {"score": 0.5, "reasons": []}, "title": "CATL signs long-term strategic deal with Seres to expand Aito battery capacity", "content": "<p><img src=\"https://cnevpost.com/wp-content/uploads/2026/10/2026101101115823.jpg\" alt=\"\" style=\"max-width: 100%; height: auto;\" /></p><p>Aito will continue using CATL batteries across its lineup, with total annual capacity set to exceed 20 GWh after a joint project is completed.</p>\n<p>For details, please visit <a href=\"https://cnevpost.com\">CnEVPost</a> (cnev.co).</p>\n", "sources": [{"name": "cnevpost", "url": "https://cnevpost.com/2026/10/11/catl-deal-seres-expand-aito-battery-capacity/", "type": "rss"}]}
